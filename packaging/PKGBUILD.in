pkgdesc='Offline rent and tenant accounts with Hindi and English statements'
url='https://github.com/iamokish/GrihaLekha'
arch=('x86_64')
license=('AGPL-3.0-or-later')
depends=('glibc' 'gcc-libs' 'glib2' 'dbus' 'fontconfig' 'freetype2'
         'nss' 'nspr' 'alsa-lib' 'libcups' 'libglvnd' 'mesa' 'libdrm'
         'libx11' 'libxext' 'libxfixes' 'libxrender' 'libxi' 'libxrandr'
         'libxdamage' 'libxcomposite' 'libxtst' 'libxcb' 'xcb-util-cursor'
         'xcb-util-wm' 'xcb-util-image' 'xcb-util-keysyms' 'xcb-util-renderutil'
         'libxkbcommon' 'libxkbcommon-x11' 'wayland')
options=('!strip' '!debug')
source=('bundle.tar')
sha256sums=('@SHA256@')

package() {
    install -dm755 "$pkgdir/opt/grihalekha"
    cp -a "$srcdir/GrihaLekha/." "$pkgdir/opt/grihalekha/"
    install -dm755 "$pkgdir/usr/bin"
    printf '#!/bin/sh\nexec /opt/grihalekha/GrihaLekha "$@"\n' > "$pkgdir/usr/bin/grihalekha"
    chmod 755 "$pkgdir/usr/bin/grihalekha"
    install -Dm644 "$startdir/grihalekha.desktop" "$pkgdir/usr/share/applications/grihalekha.desktop"
    install -Dm644 "$startdir/grihalekha.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/grihalekha.png"
