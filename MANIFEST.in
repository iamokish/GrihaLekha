include icons/grihalekha.ico
include icons/grihalekha-icon-512.png
include LICENSE THIRD_PARTY_NOTICES.md README.md USER_GUIDE.md CONTRIBUTING.md SECURITY.md CHANGELOG.md
include pyproject.toml uv.lock setup.py
